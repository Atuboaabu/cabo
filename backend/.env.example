database_url = "postgresql+psycopg://USERNAME:PASSWORD@localhost:PORT/DB_NAME"
test_database_url = "postgresql+psycopg://USERNAME:PASSWORD@localhost:PORT/TEST_DB_NAME"
sql_echo = "true"

# 将运行结果填在下方 python -c "import secrets; print(secrets.token_hex(32))"
verification_hmac_key = "xxx"
# email send
resend_api_key = "your_resend_api_key"
email_from_address = "sevenliu380@gmail.com"
